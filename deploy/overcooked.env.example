# Gabarit de /etc/overcooked.env  (à copier, renseigner, puis `chmod 600`)
# Chargé par systemd (EnvironmentFile) — une variable par ligne, sans `export`.

# --- REQUIS ---
FLASK_ENV=production
# Générer une clé stable : python -c "import os;print(os.urandom(32).hex())"
# DOIT rester identique entre redémarrages (sinon les sessions actives sont invalidées).
SECRET_KEY=REMPLACER_PAR_64_HEX
# Origine(s) autorisée(s) pour le WebSocket/HTTP (séparées par des virgules).
CORS_ALLOWED_ORIGINS=https://overcooked.exemple.fr

# --- Réseau (doit correspondre à l'upstream nginx et au bind gunicorn) ---
BIND=127.0.0.1:5000

# --- Sécurité cookies (valeurs prod par défaut ; ne décommenter que pour un test HTTP) ---
# SESSION_COOKIE_SECURE=0

# --- Reverse proxy : TRUST_PROXY est vrai par défaut en prod (nginx en façade) ---
# TRUST_PROXY=1

# --- Garde d'espace disque (Mo libres minimum avant d'autoriser un nouvel essai) ---
# MIN_FREE_DISK_MB=500

# --- Checkpoint de trajectoire (en frames ; 50 ≈ 5 s à 10 fps) ---
# TRAJECTORY_CHECKPOINT_EVERY=50

# --- Endpoint /debug : laissé fermé en prod ; =1 uniquement pour un triage ponctuel ---
# ENABLE_DEBUG_ENDPOINT=1

# --- (optionnel) chemin du fichier de config applicatif ---
# CONF_PATH=config.json
